# ---- Edit these, then:  source deploy/config.env ----
export AWS_REGION=us-east-1
export AWS_DEFAULT_REGION=$AWS_REGION
# export AWS_PROFILE=default            # uncomment if you use a named profile

export PROJECT=multiagent-poc           # prefix for every AWS resource we create
export AGENT_NAME=research_orchestrator # runtime name: letters, digits, underscore only
export ECR_REPO=multiagent-poc-agent
export MODEL_ID=us.anthropic.claude-sonnet-4-6
export METRICS_NAMESPACE=AgentCoreMultiAgentPOC

export AWS_ACCOUNT_ID=$(aws sts get-caller-identity --query Account --output text)
export ECR_URI=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPO}
echo "Account=$AWS_ACCOUNT_ID Region=$AWS_REGION Agent=$AGENT_NAME"
