# ---- Production settings. Use INSTEAD of config.env:  source deploy/config.prod.env ----
# Same agent code, different behaviour - nothing here lives in the artifact.
export AWS_REGION=us-east-1
export AWS_DEFAULT_REGION=$AWS_REGION

export PROJECT=multiagent-poc
export AGENT_NAME=research_orchestrator
export ECR_REPO=multiagent-poc-agent

# Pin the model explicitly in production. "latest" is not a thing you want a
# user-facing agent to follow: a new model version can change output quality
# without a deploy, and your eval baseline stops meaning anything.
export MODEL_ID=us.anthropic.claude-sonnet-4-6

# The three specialists do bounded work; a smaller model cuts cost and latency
# materially. Set this once you have eval numbers proving quality holds.
# export SPECIALIST_MODEL_ID=us.anthropic.claude-haiku-4-5

export REVIEW_PASS_SCORE=7      # quality gate: below this the writer rewrites
export MAX_REVISIONS=1          # rewrite budget - bounds worst-case latency and cost

export METRICS_NAMESPACE=AgentCoreMultiAgentPOC
export ENDPOINT_NAME=prod       # the endpoint 08_promote_endpoint.py moves

export AWS_ACCOUNT_ID=$(aws sts get-caller-identity --query Account --output text)
export ECR_URI=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPO}
echo "PROD config loaded: Account=$AWS_ACCOUNT_ID Region=$AWS_REGION Endpoint=$ENDPOINT_NAME Model=$MODEL_ID"
